# ==============================================================================
# Git Ignore Rules - Demo Branch (Frontend Only)
# ==============================================================================

# Node / Frontend dependencies & production builds
node_modules/
dist/
dist-ssr/
*.local
.env.production
.env.development

# Logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE / System configurations
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.user
*.sw?

# Byte-compiled python files (in case any exist)
__pycache__/
*.pyc

# Local Backends & Datasets (Prevent accidental inclusion during manual cleanup)
datasets/
AI_Predictive_Maintenance_Audio/
aipro/interface/backend/
aipro/ipad_anomaly_detection/
aipro/frame_classifier/
aipro/test_samples/
aipro/*.py
aipro/*.ps1
aipro/*.txt
aipro/demo_log*

# Recursive model ignores
**/*.pth
**/*.pt
**/*.pkl
**/*.joblib
**/*.onnx
**/*.h5
**/*.pb
